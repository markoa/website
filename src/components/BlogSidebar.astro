---
import { icon } from "@fortawesome/fontawesome-svg-core";
import { faSignal } from "@fortawesome/free-solid-svg-icons";
import { faBluesky, faXTwitter } from "@fortawesome/free-brands-svg-icons";

const icons = {
  signalIcon: icon(faSignal).html,
  xTwitterIcon: icon(faXTwitter).html,
  blueskyIcon: icon(faBluesky).html,
};

const archiveIsCurrent =
  Astro.url.pathname.replace(/\/$/, "") === "/signals/archive";
---

<aside
  id="blog-sidebar"
  class="fixed top-0 left-0 z-40 h-screen w-64 bg-panel p-8 transition-transform duration-200 ease-in-out -translate-x-full lg:top-16 lg:left-8 lg:w-48 lg:translate-x-0"
>
  <header class="mt-16 lg:mt-0">
    <nav aria-label="Primary navigation" class="space-y-4">
      <a
        href="/signals"
        class="flex items-center text-lg font-mono font-medium leading-7 text-ink"
      >
        <span class="mr-2 inline-block h-4 w-4 text-orange [&>svg]:h-4 [&>svg]:w-4">
          <Fragment set:html={icons.signalIcon} />
        </span>
        <span class="mark">signals</span>
      </a>
      <div>
        <a href="/" class="quiet whitespace-nowrap text-sm leading-5">by Marko Anastasov</a>
      </div>
    </nav>
  </header>

  <nav aria-label="Social links" class="mt-8 space-y-2 text-sm">
    <a
      href="/signals/archive"
      class="inline-flex items-center gap-2 font-mono text-sm leading-5"
      aria-current={archiveIsCurrent ? "page" : undefined}
    >
      <span class={archiveIsCurrent ? "is-current" : "quiet"}>archive</span>
      {archiveIsCurrent && <span class="current-mark" aria-hidden="true"></span>}
    </a>
    <a href="/signals/rss.xml" class="quiet block font-mono text-sm leading-5">
      RSS
    </a>
    <a
      href="https://x.com/markoa"
      rel="me"
      aria-label="Follow me on X (Twitter)"
      class="icon-link block"
    >
      <span class="inline-block h-3 w-3 [&>svg]:h-3 [&>svg]:w-3">
        <Fragment set:html={icons.xTwitterIcon} />
      </span>
    </a>
    <a
      href="https://bsky.app/profile/markoanastasov.bsky.social"
      rel="me"
      aria-label="Follow me on Bluesky"
      class="icon-link block"
    >
      <span class="inline-block h-3 w-3 [&>svg]:h-3 [&>svg]:w-3">
        <Fragment set:html={icons.blueskyIcon} />
      </span>
    </a>
  </nav>
</aside>

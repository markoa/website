---
import avatar from "../assets/avatar.jpg";
import Layout from "../layouts/Layout.astro";
import { icon } from "@fortawesome/fontawesome-svg-core";
import {
  faXTwitter,
  faLinkedinIn,
  faGithub,
  faBluesky,
} from "@fortawesome/free-brands-svg-icons";
import { faRss } from "@fortawesome/free-solid-svg-icons";

const icons = {
  twitter: icon(faXTwitter).html,
  linkedin: icon(faLinkedinIn).html,
  bluesky: icon(faBluesky).html,
  github: icon(faGithub).html,
  rss: icon(faRss).html,
};

const links = [
  { href: "/signals", label: "Blog", icon: icons.rss },
  { href: "https://x.com/markoa", label: "@markoa", icon: icons.twitter, rel: "me" },
  {
    href: "https://bsky.app/profile/markoanastasov.bsky.social",
    label: "Bluesky",
    icon: icons.bluesky,
    rel: "me",
  },
  {
    href: "https://www.linkedin.com/in/markoa/",
    label: "LinkedIn",
    icon: icons.linkedin,
    rel: "me",
  },
  { href: "https://github.com/markoa", label: "GitHub", icon: icons.github, rel: "me" },
];
---

<Layout title="Marko Anastasov" ground="chassis">
  <div class="flex min-h-screen items-center justify-center bg-chassis">
    <div class="w-full max-w-xs rounded bg-panel p-6">
      <img
        class="mx-auto mb-4 h-32 w-32 rounded-full border-[3px] border-orange"
        src={avatar.src}
        alt="Profile Picture"
      />
      <h1
        class="mb-4 text-center text-xl font-bold leading-7 tracking-[-0.015em] text-ink"
      >
        Marko Anastasov
      </h1>
      <p class="mb-4 text-center text-base leading-6 text-ink">
        👋 Tech entrepreneur, open source builder. Cofounder of <a
          class="bio-link"
          href="https://superplane.com">SuperPlane</a
        >,
        <a class="bio-link" href="https://semaphore.io">Semaphore</a> and <a
          class="bio-link"
          href="https://operately.com">Operately</a
        >.
      </p>
      <p class="mb-4 text-center text-base leading-6 text-ink">
        🤝 I do business execution, product design, marketing, and engineering.
      </p>
      <p class="mb-8 text-center text-base leading-6 text-ink">👨‍👩‍👧‍👦 Dad ×2</p>
      <ul class="space-y-4">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.rel}
                class="key flex w-full items-center justify-center gap-2 rounded px-4 py-2"
              >
                <span class="inline-flex h-4 w-4 [&>svg]:h-4 [&>svg]:w-4">
                  <Fragment set:html={link.icon} />
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

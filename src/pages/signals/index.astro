---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import MenuButton from "../../components/MenuButton.astro";
import PhotoPost from "../../components/PhotoPost.astro";
import SignalMeta from "../../components/SignalMeta.astro";

const posts = await getCollection("signals", ({ data }) => {
  return import.meta.env.PROD ? data.published : true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const currentYear = new Date().getFullYear();
const postsThisYear = sortedPosts.filter(
  (post) => post.data.pubDate.getFullYear() === currentYear
);

const renderedPosts = await Promise.all(
  postsThisYear.map(async (post) => {
    const { Content } = await render(post);
    return { ...post, Content };
  })
);
---

<Layout title="Signals">
  <div class="flex min-h-screen">
    <MenuButton />
    <BlogSidebar />

    <main
      class="w-full max-w-3xl px-8 pb-16 pt-24 lg:ml-48 lg:py-16 lg:pl-48 lg:pr-8"
    >
      <div class="space-y-48">
        {
          renderedPosts.length > 0 ? (
            renderedPosts.map((post) => (
              <article class="space-y-4">
                {post.data.type === "photo" && (
                  <PhotoPost
                    image={post.data.image}
                    description={post.data.description}
                  />
                )}

                {post.data.type !== "photo" && (
                  <h2 class="text-2xl font-semibold leading-8 tracking-[-0.02em] text-ink">
                    {post.data.type === "link" ? (
                      <a href={post.data.url} class="title-link">
                        {post.data.title}{" "}
                        <span class="link-arrow" aria-hidden="true">
                          →
                        </span>
                      </a>
                    ) : (
                      <a href={`/signals/${post.id}`} class="title-link">
                        {post.data.title}
                      </a>
                    )}
                  </h2>
                )}

                <div class="prose prose-lg prose-quoteless">
                  <post.Content />
                </div>

                <SignalMeta
                  pubDate={post.data.pubDate}
                  permalink={`/signals/${post.id}`}
                  xPostId={post.data.xPostId}
                  blueskyPostId={post.data.blueskyPostId}
                  linkedinPostId={post.data.linkedinPostId}
                  hackerNewsPostId={post.data.hackerNewsPostId}
                  zoraPostId={post.data.zoraPostId}
                />
              </article>
            ))
          ) : (
            <p class="text-sm text-label">
              No signals yet this year. Browse the{" "}
              <a href="/signals/archive" class="ink-link">
                archive
              </a>
              .
            </p>
          )
        }
      </div>

      <p class="mt-24 text-sm text-label">
        <a href="/signals/archive" class="quiet">
          Browse older posts in the archive
        </a>
        <span aria-hidden="true"> →</span>
      </p>
    </main>
  </div>
</Layout>

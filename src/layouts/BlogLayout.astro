---
import Layout from "./Layout.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import MenuButton from "../components/MenuButton.astro";
import PhotoPost from "../components/PhotoPost.astro";
import SignalMeta from "../components/SignalMeta.astro";

const { frontmatter, slug } = Astro.props;

const canonicalURL =
  frontmatter.canonicalUrl ??
  new URL(Astro.url.pathname, Astro.site).toString();
const photo =
  frontmatter.type === "photo" && frontmatter.image
    ? typeof frontmatter.image === "string"
      ? frontmatter.image
      : new URL(frontmatter.image.src, Astro.site).toString()
    : undefined;
const ogImage =
  frontmatter.type === "photo" ? photo : slug ? `/signals/${slug}.png` : undefined;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  canonicalURL={canonicalURL}
  ogType="article"
  photo={photo}
  ogImage={ogImage}
>
  <div class="flex min-h-screen">
    <MenuButton />
    <BlogSidebar />

    <main
      class="w-full max-w-3xl px-8 pb-16 pt-24 lg:ml-48 lg:py-24 lg:pl-48 lg:pr-8"
    >
      <article class="space-y-4">
        {
          frontmatter.type === "photo" && (
            <PhotoPost
              image={frontmatter.image}
              description={frontmatter.description}
            />
          )
        }

        {
          frontmatter.type !== "photo" && (
            <h1 class="mb-8 text-3xl font-semibold leading-9 tracking-[-0.02em] text-ink">
              {frontmatter.type === "link" ? (
                <a href={frontmatter.url} class="title-link">
                  {frontmatter.title}{" "}
                  <span class="link-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ) : (
                frontmatter.title
              )}
            </h1>
          )
        }

        <div class="prose prose-lg prose-quoteless">
          <slot />
        </div>
        {
          frontmatter.canonicalUrl && (
            <p class="mt-4 font-sans text-sm italic text-label">
              Originally posted on{" "}
              <a
                href={frontmatter.canonicalUrl}
                class="ink-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {frontmatter.canonicalUrl}
              </a>
            </p>
          )
        }

        <SignalMeta
          pubDate={frontmatter.pubDate}
          xPostId={frontmatter.xPostId}
          blueskyPostId={frontmatter.blueskyPostId}
          linkedinPostId={frontmatter.linkedinPostId}
          hackerNewsPostId={frontmatter.hackerNewsPostId}
          zoraPostId={frontmatter.zoraPostId}
        />
      </article>
    </main>
  </div>
</Layout>
